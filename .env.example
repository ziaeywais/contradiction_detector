# Anthropic API key — required for --provider claude or --provider both
ANTHROPIC_API_KEY=your-key-here

# Ollama settings — required for --provider ollama or --provider both
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# Model to use for contradiction detection (must be pulled: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
